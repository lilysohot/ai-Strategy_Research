# Legacy pre-rename paths: untracked corpora/artifacts still sit here on older
# checkouts, and un-ignoring them puts multi-GB (and license-gated) data one
# `git add -A` away from a commit.
benchmarks/results/
benchmarks/tasks-generated/
experiments/
results/
logs/
tmp/
temp/
data/
benchmarks/public/datasets
benchmarks/datasets
private/

# User specific claude configurations
.claude

# ── 投研资料库（P0b 起）───────────────────────────────────────────────────
# 研报原文 + SQLite 索引。全量 8000 份按 5–20GB 估，一旦误入库几乎不可逆。
# 上面已有裸 `data/`，此处重复声明是刻意的：让
# `git check-ignore -v data/corpus/corpus.db` 直接命中这一行，
# 不依赖读者回溯到泛化的 `data/`。
data/corpus/

# ── Web platform (server/) ────────────────────────────────────────────────
# Per-run artifacts: trajectory (run/agent/trajectories/*.jsonl|json), engine
# logs, agent deliverables and uploaded inputs. Runtime data, never committed —
# the trajectory also embeds per-run system prompts and file contents.
server/runs/
# Uploaded financial PDFs / research reports.
uploads/
# Local dev SQLite (the default when SERVER_DATABASE_URL is unset); production
# uses Postgres and Alembic.
server/dev.db
server/*.db
.codebuddy/
.codebuddy/memory/MEMORY.md
.e5runs
.e5runs_e5
.e5runs_e5_160401-failed-infra
.s5runs_v14_full
.s5runs_v14_full_invalidated

# ── .scratch 本地运行产物（pilot 构建/日志）────────────────────────────
# .scratch/ 本身是仓库文档化的（spec.md / issues/ / report.md 被 docs 引用），
# 故不整目录忽略，仅忽略 pilot 目录下的中间产物；report.md 与 *.py 仍可提交。
.scratch/corpus-vector-pilot-20261020/*.log
.scratch/corpus-vector-pilot-20261020/*.pid
.scratch/corpus-vector-pilot-20261020/build-results.json
.scratch/corpus-vector-pilot-20261020/vector-build-*.json
.scratch/corpus-vector-pilot-20261020/vector-eval-*.json
.scratch/corpus-vector-pilot-20261020/vector-*.log
.scratch/corpus-vector-acceptance-20261020/
.scratch/corpus-vector-pilot-20261020/
.scratch/corpus-contextual-prefix-20261020

# ── .scratch 实验产物：默认忽略，白名单放行 ─────────────────────────
# 背景：AGENTS.md 把 .scratch/<slug>/ 定义为 issue tracker，docs/ 与 README
# 有大量相对链接指向 spec.md / issues/ / report.md / 证据 json；但每个隔离实验
# 都会新开一个目录，逐条加规则不可持续（且日期后缀无法区分两类目录）。
#
# 方案：默认忽略 .scratch 下所有一级子目录，仅显式放行被仓库文档引用的目录。
# 新增实验目录无需改本文件；某目录确实要入库时，在下方加一行 ! 放行。
# 注意：gitignore 不解除已跟踪文件，历史产物需 `git rm -r --cached <dir>` 清理。
.scratch/*/

# 白名单：被 docs/ AGENTS.md 引用、需要入库的目录
!.scratch/corpus-evidence-pipeline/
!.scratch/claims-r2-role-isolation/
!.scratch/web-runtime-trace-hardening/
!.scratch/web-business-repairs/
!.scratch/web-business-session-plan/
!.scratch/web-business-context/
!.scratch/web-input-request-fix-20261009/
!.scratch/cli-web-parity/
!.scratch/a4-loop-20260929/
!.scratch/m6-retrieval-fix-20260923/
!.scratch/m6-repair-20260923/
!.scratch/corpus-new7-20261021/
!.scratch/corpus-native-tools-20261022/
!.scratch/corpus-production-release-20261022/
!.scratch/corpus-production-release-20261024/
!.scratch/p0a-research-kernel/

# 兜底：即使在白名单目录内，也忽略可再生成的产物
.scratch/**/*.log
.scratch/**/*.pid
.scratch/**/live/
