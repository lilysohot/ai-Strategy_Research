# Required: model used by the built-in react and agent_team profiles.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional: benchmark judge/scorer endpoint. Falls back to OPENAI_* when empty.
# FrontierSearchBench's scorer takes JUDGE_API_KEY + JUDGE_BASE_URL as its
# OPENROUTER_* pair (key and URL always come from the same provider). It pins
# its own model slate, so JUDGE_MODEL does not apply to it.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=

# Optional: benchmark dataset configuration.
# HF_TOKEN is required for gated datasets such as OfficeQA and APEX.
HF_TOKEN=
# OfficeQA corpus format: parsed (default) or raw. Raw mode requires downloading
# the dataset with --raw-pdfs.
OFFICEQA_DOC_MODE=parsed
# Store large benchmark datasets outside the repository when desired.
FRONTIER_AGENT_DATASETS_DIR=

# Optional: web search and page fetching.
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
JINA_API_KEY=
JINA_BASE_URL=https://r.jina.ai

# Optional: condense long fetched pages with an OpenAI-compatible endpoint.
# SUMMARY_LLM_BASE_URL must be the full chat-completions URL.
# Leave these empty and page extraction automatically falls back to the
# OPENAI_BASE_URL / OPENAI_MODEL above. Point them at a cheaper/faster model
# to keep whole scraped pages off your primary model's token bill.
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_BASE_URL=
SUMMARY_LLM_MODEL_NAME=

# Optional: read images and image-only PDF pages. Recommended for OfficeQA;
# without it, image-based questions may lose points.
# READDOC_VISION_URL is an OpenAI-compatible base URL including /v1.
READDOC_VISION_URL=
READDOC_VISION_MODEL=
READDOC_VISION_KEY=

# Optional: OCR scanned PDFs via POST <url>/ocr.
READDOC_OCR_URL=
READDOC_OCR_KEY=

# Optional: 同花顺 fuyao 市场数据（market 模块：行情 / 估值 / 财报 / 复权因子）。
# THS_API_KEY 是唯一必填项，对应 HTTP 请求头 X-api-key；缺失时 market 工具恒定
# ok=false 并明确报错，不会静默返回空数据，也不会拖垮主流程。
THS_API_KEY=
THS_API_BASE_URL=https://fuyao.aicubes.cn
# 总开关：false 时 market 工具恒定 ok=false，核心流程退化为未接入形态。
MARKET_ENABLED=true
# 响应留痕：on 时写 run 目录，硬闸①可证伪「来源与时点」；off 时降级为哈希自证（闸标 partial）。
MARKET_TRACE=on

# Optional: platform business DB（业务库：用户 / 会话 / run 记录，迁移自 server/dev.db）。
# 留空时回退到代码默认值 sqlite+aiosqlite:///./server/dev.db。
SERVER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apodex

# Optional: corpus DB（研究语料库，PostgreSQL）。
# **注意**：语料库与上面的业务库是**同一实例上的不同 database**（语料默认
# `postgres`、业务 `apodex`），host / port / 账号通常相同、仅库名不同——极易连错，
# 改配置时务必核对。两者各司其职，不需要 join。
#
# CORPUS_DSN 是语料库的唯一配置入口；留空时回退到下面的 CORPUS_DB_* 组件，
# 再回退到本机开发默认值。
#   - 本机 CLI / 测试：localhost 即可（WSL2 localhost 转发到 Windows 宿主）。
#   - 容器内运行：**不能用 localhost**（那是容器自身），改用 host.docker.internal、
#     显式服务名或宿主 IP。
CORPUS_DSN=postgresql://postgres:postgres@localhost:5432/postgres
# CORPUS_DSN 留空时，以下组件用于拼装连接串；也供 docker/docker-compose.yml
# 初始化 corpus-db 容器使用（两处取值应保持一致）。
CORPUS_DB_HOST=localhost
CORPUS_DB_PORT=5432
CORPUS_DB_NAME=postgres
CORPUS_DB_USER=postgres
CORPUS_DB_PASSWORD=postgres
# 语料新链目标库（目标解析唯一开关，plugins/corpus/preparation/pg_target.py）：
# 缺省 fail-closed 绑隔离演练库 i2_sandbox_corpus；仅在显式设置后才放行所指向的
# 目标库（含生产实例反证闸）。I4 切换后日常服务应指向承载 corpus schema 的库。
CORPUS_TARGET_DB=

# Optional: server secrets。
# JWT 签名密钥：轮换会使所有人登出（与 SERVER_MASTER_KEY 分离——后者轮换会
# 使已存的 LLM api_key 失效，用户需重新录入）。
SERVER_JWT_SECRET=
# 本地开发：跳过启动密钥检查（降级为警告）；部署时必须删除并设置强随机
# SERVER_MASTER_KEY，否则服务拒绝启动。
SERVER_DEBUG=true
