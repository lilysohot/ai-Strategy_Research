{
  "name": "frontier-agent-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "投研 Agent 平台前端（M3）：Vue3 + Vite + TypeScript + Pinia + Element Plus",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
