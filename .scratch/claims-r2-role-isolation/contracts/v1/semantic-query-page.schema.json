{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent.local/contracts/corpus-structured/v1/semantic-query-page.schema.json",
  "title": "Read-only semantic query page",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query_id", "publication_id", "query_sha256", "sort_version", "purpose", "records", "next_cursor", "page_status", "error_codes"],
  "properties": {
    "schema_version": {"const": "corpus-semantic-query-page-v1"},
    "query_id": {"type": "string", "minLength": 1}, "publication_id": {"$ref": "#/$defs/hash"},
    "query_sha256": {"$ref": "#/$defs/hash"}, "sort_version": {"const": "semantic-lexical-sort-v1"},
    "purpose": {"enum": ["cite", "compare", "calculate"]},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "next_cursor": {"type": ["string", "null"]},
    "page_status": {"enum": ["complete", "more_available", "budget_limited", "no_match", "not_extracted", "not_published", "cursor_stale"]},
    "error_codes": {"type": "array", "items": {"type": "string", "pattern": "^CS_[A-Z0-9_]+$"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "role", "usable_for", "evidence", "dependencies", "context_status", "mapping_status", "quality_status"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1}, "role": {"enum": ["claims", "material_items", "material_relations"]},
        "usable_for": {"type": "array", "items": {"enum": ["cite", "compare", "calculate"]}, "uniqueItems": true},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "context_status": {"enum": ["complete", "partial", "missing", "ambiguous", "budget_exceeded"]},
        "mapping_status": {"enum": ["confirmed", "suspected", "unlinked", "conflict"]},
        "quality_status": {"enum": ["accepted", "review_required", "rejected"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["handle", "unit_id", "locator", "quote", "coordinate_system", "start", "end", "text_sha256"],
      "properties": {
        "handle": {"type": "string", "pattern": "^cv2:[A-Za-z0-9._:-]+#chunk:[A-Za-z0-9._:-]+$"},
        "unit_id": {"type": "string"}, "locator": {"type": "string"}, "quote": {"type": "string", "minLength": 1},
        "coordinate_system": {"const": "unicode_code_points"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1},
        "text_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "evidence_index", "required_for", "status"],
      "properties": {
        "kind": {"enum": ["value", "period", "unit", "header", "footnote", "condition", "negation", "attribution"]},
        "evidence_index": {"type": "integer", "minimum": 0},
        "required_for": {"type": "array", "items": {"enum": ["cite", "compare", "calculate"]}, "minItems": 1, "uniqueItems": true},
        "status": {"enum": ["present", "missing", "ambiguous"]}
      }
    }
  }
}

