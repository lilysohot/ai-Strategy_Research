{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent.local/contracts/corpus-structured/v1/evidence-snapshot.schema.json",
  "title": "Immutable evidence snapshot envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "source_id", "build_id", "publication_generation", "parser_versions", "units", "gaps", "identity_input"],
  "properties": {
    "schema_version": {"const": "corpus-evidence-snapshot-v1"},
    "snapshot_id": {"$ref": "#/$defs/hash"},
    "source_id": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 1},
    "publication_generation": {"type": "integer", "minimum": 1},
    "parser_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "identity_input": {"$ref": "#/$defs/identity"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinate_system", "text_sha256", "start", "end"],
      "properties": {
        "coordinate_system": {"const": "unicode_code_points"},
        "text_sha256": {"$ref": "#/$defs/hash"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "chunk_id", "kind", "locator", "text", "text_sha256", "span", "metadata", "metadata_sha256", "dependencies"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "chunk_id": {"type": "string", "pattern": "^chunk:[A-Za-z0-9._:-]+$"},
        "kind": {"enum": ["prose", "table", "table_note", "heading", "image_text", "gap"]},
        "locator": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "text_sha256": {"$ref": "#/$defs/hash"},
        "span": {"$ref": "#/$defs/span"},
        "metadata": {"type": "object"},
        "metadata_sha256": {"$ref": "#/$defs/hash"},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "code", "locator", "context_status"],
      "properties": {
        "gap_id": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "context_status": {"enum": ["partial", "missing", "ambiguous", "budget_exceeded"]}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_id", "build_id", "publication_generation", "parser_versions", "unit_identities"],
      "properties": {
        "schema_version": {"const": "corpus-evidence-snapshot-v1"},
        "source_id": {"type": "string"},
        "build_id": {"type": "string"},
        "publication_generation": {"type": "integer"},
        "parser_versions": {"type": "object"},
        "unit_identities": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["unit_id", "chunk_id", "kind", "locator", "coordinate_system", "start", "end", "text_sha256", "metadata_sha256"],
            "properties": {
              "unit_id": {"type": "string"}, "chunk_id": {"type": "string"}, "kind": {"type": "string"}, "locator": {"type": "string"},
              "coordinate_system": {"const": "unicode_code_points"}, "start": {"type": "integer"}, "end": {"type": "integer"},
              "text_sha256": {"$ref": "#/$defs/hash"}, "metadata_sha256": {"$ref": "#/$defs/hash"}
            }
          }
        }
      }
    }
  }
}

