  "scope_rules": [
    "候选只接收 candidate_input_scope 指定的非表格原文单元、来源元信息和既有角色提示；不得输入本包金标、目标ID或标注结果。",
    "目标召回分母仅为人工接受的本包记录；并不宣称覆盖两份材料的所有命题。",
    "声明范围外的输出独立登记 out_of_scope；范围内未命中金标的输出必须裁定，不能自动当 FP。",
    "额外正确输出标为 correct_extra，用于候选正确率；不添加到已冻结目标金标，不追溯增加召回分母。",
    "raw 与 validated 候选逐条分别裁定；漏抽、空输出、拒绝、失败保持在目标召回分母。"
  ],
  "matching": {
    "mode": "human_adjudicated_semantic_equivalence_then_one_to_one_mapping",
    "claims": "独立从候选字段及原文核对主体、指标、期间、数值/区间、单位、实际/预测、约数、归属与来源态度。原文质疑和早期预计等限定必须一并交付。",
    "items": "同义改写可接受；须保持一个原子命题、语义类型、话语角色、归属、否定、条件、行为意向。proposition 不用逐字字符串相等判定。",
    "conditions": "condition_logic 与 condition_groups 约束值、比较符、单位、基期及 AND/OR。I17 子项内部逻辑不明；保留原文或显式未知均可，擅自填 AND/OR 或去掉门槛不匹配。",
    "relations": "先独立判定两端 item 并一对一建立 candidate_item_id -> gold_record_id，随后比较有向端点、type、source_explicit 和关系原文。允许多条关系共享一个动作端点。",
    "unknowns": "未明确来源保留 unknown；不得猜具体公司、人物或把同源转述当独立证据。",
    "normalization": "数值仅做十进制单位缩放和闭区间规范化；日期和期间保留基准语境；约数不能升级成精确承诺。记录所用规则，不从金标反填候选缺字段。",
    "projection": "现有 strict scorer 只接受裁定完成的语义映射；映射须保存原始候选字段、裁定人、理由和依据。不得将目标字符串直接赋给候选并宣称自动语义评分。"
  },
  "metrics": {
    "target_recall": "accepted_gold_matched_once / accepted_gold_total；分角色，并保留原始/校验后切片。",
    "candidate_precision": "(matched + correct_extra) / (matched + correct_extra + incorrect + duplicate)；unresolved 非零则 N/A，不能排除后报告通过。",
    "duplicates": "同义重复仅第一条可匹配；后续记录 duplicate 计 FP。I16 为唯一止损动作，可供 R08/R09 共用。",
    "selected_projection_precision": "不报告为完整抽取 precision；只看选中目标的候选投影会遗漏 FP。",
    "risk_condition": "按角色分别报告标记记录数；总体仍可按既有 scorer 计算，但 items 与关系相关，不称独立风险场景。",
    "quality_gate": "当前包和新增裁定口径均待人工签认；未获得完整候选裁定、query/delivery/context_use 时不得宣告整体质量门通过。"
  },
