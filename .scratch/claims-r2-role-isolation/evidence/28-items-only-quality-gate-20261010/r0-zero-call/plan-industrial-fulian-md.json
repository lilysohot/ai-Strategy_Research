      {
        "unit_id": "snapshot-unit:6ec5cecf7239672a2b430eb25c02b291c840485b53d4b21e058ef5894336d609",
        "chunk_id": "chunk:signed-non-table-target-scope",
        "kind": "prose",
        "locator": "char:5055-5071",
        "text": "四选一：**持有 + 观望。**",
        "text_sha256": "sha256:77611e276f516e7b66a3e620abb849c7aa6d76d505cd8a5cc2bc2623328e44af",
        "span": {
          "coordinate_system": "unicode_code_points",
