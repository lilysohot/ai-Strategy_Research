    "high_risk_item_annotations": {
      "NT-I13": {
        "condition": "Q3 OCF/扣非净利润 >= 0.6",
        "condition_logic": {
          "op": "compare",
          "metric": "OCF_to_adjusted_profit",
          "period": "Q3",
          "comparator": ">=",
          "value": "0.6",
          "unit": "ratio"
        }
      },
      "NT-I15": {
        "condition": "下季 OCF/扣非净利润 < 0.5",
        "condition_logic": {
          "op": "compare",
          "metric": "OCF_to_adjusted_profit",
          "period": "next_quarter",
          "comparator": "<",
          "value": "0.5",
          "unit": "ratio"
        }
      },
      "NT-I17": {
        "condition": "毛利率相对6.99%下降>1个百分点 AND 公司改口“涨价/mix受阻、Rubin延期”（并列项内部逻辑未明）",
        "condition_logic": {
          "op": "all",
          "args": [
            {
              "op": "compare",
              "metric": "gross_margin_change_from_baseline",
              "baseline": "6.99",
              "comparator": "<",
              "value": "-1",
              "unit": "percentage_points"
            },
            {
              "op": "source_clause",
              "text": "公司改口说涨价/mix 受阻、Rubin 延期",
              "inner_operator": "unknown"
            }
          ]
        },
        "unknown_fields": [
          "condition_inner_boolean"
        ]
      },
      "NT-I09": {
        "condition": "毛利率继续下降或Rubin延期",
        "atomic_proposition_source": "condition",
        "compound": true,
        "sub_conditions": [
          "毛利率继续下降",
          "Rubin延期"
        ],
        "compound_rule": "二元析取（「或」），无 condition_logic；按 condition_role_read_path.compound_condition 计分，命中任一子条件计为部分命中，不得整体匹配。"
      },
      "NT-I19": {
        "condition": "出口管制影响GPU系统集成",
        "atomic_proposition_source": "condition",
        "compound": false
      },
      "NT-I29": {
        "condition": "政策变化导致成本上升",
        "atomic_proposition_source": "condition",
        "compound": false
      },
      "NT-I35": {
        "condition": "无差别相信所有公司的份额陈述",
        "atomic_proposition_source": "condition",
        "compound": false
      },
      "NT-I39": {
        "condition": "海外产能税率增加",
