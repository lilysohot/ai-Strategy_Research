        "unknown_fields": []
      },
      {
        "item_id": "itm_634ad4c69acab38a",
        "text": "原料价格波动较大时，应重点观察产品价差；仅当成本相对稳定、价格与价差走势趋于一致时，产品价格才可代表景气的变化。",
        "semantic_type": "opinion",
        "statement_role": "condition",
        "speech_role": "answer",
