    "items": [
      {
        "item_id": "itm_578222f80c40fe5d",
        "text": "化工行业兼具周期与成长属性，子行业景气周期相互错位，使板块长期具备结构性投资机会。",
        "semantic_type": "opinion",
        "statement_role": "claim",
        "speech_role": "statement",
        "perspective": "source_explicit",
        "speaker_ref": "spk_b30c01880ad2",
        "polarity": "affirmed",
        "value": null,
        "behavior_status": null,
        "temporal_frame": "unknown",
        "evidence": [
          {
            "source_rev": "174b64628f35aca6",
