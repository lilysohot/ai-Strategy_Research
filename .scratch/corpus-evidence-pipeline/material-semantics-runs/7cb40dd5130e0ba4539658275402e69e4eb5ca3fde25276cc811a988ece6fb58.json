        "item_id": "itm_6ac4d28e5d9a7a72",
        "text": "每1万吨锂电铜箔的主设备投资约2.5-3亿元，阴极辊约150万元/台、生箔机（含阳极板）约200万元/台为关键设备，1万吨需24套。",
        "semantic_type": "fact",
        "statement_role": "claim",
        "speech_role": "statement",
        "perspective": "source_explicit",
        "speaker_ref": "spk_b046dbf69a34",
        "polarity": "affirmed",
        "value": null,
        "behavior_status": null,
        "temporal_frame": "unknown",
        "evidence": [
