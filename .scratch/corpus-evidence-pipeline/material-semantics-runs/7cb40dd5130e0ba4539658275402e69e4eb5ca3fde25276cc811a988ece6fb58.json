        "unknown_fields": []
      },
      {
        "item_id": "itm_2dc96bd5e22bc925",
        "text": "标箔在生箔机基础上需加配表面处理机，1万吨投资约3-4亿元；HTE约600-700万元，HVLP超过1000万元，配套比例从6:1提高到3-4:1。",
        "semantic_type": "fact",
        "statement_role": "claim",
        "speech_role": "statement",
        "perspective": "source_explicit",
        "speaker_ref": "spk_b046dbf69a34",
