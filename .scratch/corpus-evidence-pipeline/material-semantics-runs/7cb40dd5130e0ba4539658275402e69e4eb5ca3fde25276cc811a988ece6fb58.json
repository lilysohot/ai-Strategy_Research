        "unknown_fields": []
      },
      {
        "item_id": "itm_faeeaf48926a5891",
        "text": "全球表处理设备主要厂商包括日本三船、西工业、TEX，韩国PNT等，价格约2000万元，交期6-12个月；泰金价格仅1000万出头、交期1个月，缺的是大规模验证。",
        "semantic_type": "fact",
        "statement_role": "claim",
